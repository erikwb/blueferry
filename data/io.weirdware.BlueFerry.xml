<?xml version="1.0" encoding="UTF-8"?>
<node name="/io/weirdware/BlueFerry">
  <interface name="io.weirdware.BlueFerry.Messages1">
    <annotation name="org.freedesktop.DBus.Description"
                value="Version 1 messaging, history, status, and contact operations"/>
    <annotation name="io.weirdware.BlueFerry.Errors"
                value="AuthorizationRequired,RateLimited"/>
    <method name="Send">
      <arg name="recipient" type="s" direction="in"/>
      <arg name="body" type="s" direction="in"/>
      <arg name="transfer_path" type="s" direction="out"/>
      <annotation name="io.weirdware.BlueFerry.Errors"
                  value="InvalidArgs,NotReady,SendFailed,SendOutcomeUnknown"/>
    </method>
    <method name="SendToThread">
      <annotation name="org.freedesktop.DBus.Description"
                  value="Legacy direct-thread send; group replies require SendToThreadChecked"/>
      <arg name="thread_key" type="s" direction="in"/>
      <arg name="body" type="s" direction="in"/>
      <arg name="confirm_group" type="b" direction="in"/>
      <arg name="transfer_path" type="s" direction="out"/>
      <annotation name="io.weirdware.BlueFerry.Errors"
                  value="InvalidArgs,NotFound,NotReady,ConfirmationRequired,SendFailed,SendOutcomeUnknown"/>
    </method>
    <method name="SendToThreadChecked">
      <arg name="thread_key" type="s" direction="in"/>
      <arg name="body" type="s" direction="in"/>
      <arg name="confirm_group" type="b" direction="in"/>
      <arg name="expected_group_token" type="s" direction="in"/>
      <arg name="transfer_path" type="s" direction="out"/>
      <annotation name="io.weirdware.BlueFerry.Errors"
                  value="InvalidArgs,NotFound,NotReady,ConfirmationRequired,SendFailed,SendOutcomeUnknown"/>
    </method>
    <method name="ListEvents">
      <arg name="kinds" type="as" direction="in"/>
      <arg name="limit" type="u" direction="in"/>
      <arg name="json" type="s" direction="out"/>
      <annotation name="io.weirdware.BlueFerry.Errors"
                  value="InvalidArgs,ResponseTooLarge"/>
    </method>
    <method name="ListThreads">
      <arg name="limit" type="u" direction="in"/>
      <arg name="json" type="s" direction="out"/>
      <annotation name="io.weirdware.BlueFerry.Errors"
                  value="ResponseTooLarge"/>
    </method>
    <method name="MarkThreadRead">
      <arg name="thread_key" type="s" direction="in"/>
      <arg name="updated" type="u" direction="out"/>
      <annotation name="io.weirdware.BlueFerry.Errors"
                  value="InvalidArgs,NotFound,NotReady"/>
    </method>
    <method name="SetThreadStarred">
      <arg name="thread_key" type="s" direction="in"/>
      <arg name="starred" type="b" direction="in"/>
      <arg name="starred_state" type="b" direction="out"/>
      <annotation name="io.weirdware.BlueFerry.Errors"
                  value="InvalidArgs,NotFound,NotReady"/>
    </method>
    <method name="FindContacts">
      <arg name="query" type="s" direction="in"/>
      <arg name="json" type="s" direction="out"/>
      <annotation name="io.weirdware.BlueFerry.Errors"
                  value="InvalidArgs,NotReady,ResponseTooLarge"/>
    </method>
    <method name="ListContacts">
      <arg name="offset" type="u" direction="in"/>
      <arg name="limit" type="u" direction="in"/>
      <arg name="json" type="s" direction="out"/>
      <annotation name="io.weirdware.BlueFerry.Errors"
                  value="NotReady,ResponseTooLarge"/>
    </method>
    <method name="SetGroupParticipants">
      <arg name="thread_key" type="s" direction="in"/>
      <arg name="recipients" type="as" direction="in"/>
      <arg name="thread_json" type="s" direction="out"/>
      <annotation name="io.weirdware.BlueFerry.Errors"
                  value="InvalidArgs,NotFound,NotReady,ResponseTooLarge"/>
    </method>
    <method name="GetStatus">
      <arg name="json" type="s" direction="out"/>
    </method>
    <method name="ClearHistory">
      <arg name="confirmed" type="b" direction="in"/>
      <annotation name="io.weirdware.BlueFerry.Errors"
                  value="ConfirmationRequired"/>
    </method>
    <method name="DeleteThreads">
      <arg name="thread_keys" type="as" direction="in"/>
      <arg name="confirmed" type="b" direction="in"/>
      <arg name="deleted_conversations" type="u" direction="out"/>
      <annotation name="io.weirdware.BlueFerry.Errors"
                  value="InvalidArgs,NotFound,NotReady,ConfirmationRequired"/>
    </method>
    <method name="GetNotificationPolicy">
      <arg name="policy" type="s" direction="out"/>
    </method>
    <method name="SetNotificationPolicy">
      <arg name="policy" type="s" direction="in"/>
      <arg name="selected_policy" type="s" direction="out"/>
      <annotation name="io.weirdware.BlueFerry.Errors"
                  value="InvalidArgs,NotReady"/>
    </method>
    <method name="GetContactsOnlyNotifications">
      <arg name="enabled" type="b" direction="out"/>
    </method>
    <method name="SetContactsOnlyNotifications">
      <arg name="enabled" type="b" direction="in"/>
      <arg name="selected" type="b" direction="out"/>
      <annotation name="io.weirdware.BlueFerry.Errors"
                  value="InvalidArgs,NotReady"/>
    </method>
    <method name="GetStoragePolicy">
      <arg name="policy" type="s" direction="out"/>
    </method>
    <method name="SetStoragePolicy">
      <arg name="policy" type="s" direction="in"/>
      <arg name="status_json" type="s" direction="out"/>
      <annotation name="io.weirdware.BlueFerry.Errors"
                  value="InvalidArgs,NotReady"/>
    </method>
    <method name="UnlockStorage">
      <arg name="status_json" type="s" direction="out"/>
      <annotation name="io.weirdware.BlueFerry.Errors"
                  value="NotReady"/>
    </method>
    <method name="ListRecent">
      <arg name="folder" type="s" direction="in"/>
      <arg name="limit" type="u" direction="in"/>
      <arg name="json" type="s" direction="out"/>
      <annotation name="io.weirdware.BlueFerry.Errors"
                  value="InvalidArgs,NotReady,QueryFailed,ResponseTooLarge"/>
    </method>
    <method name="SyncContacts">
      <arg name="cached_count" type="u" direction="out"/>
      <annotation name="io.weirdware.BlueFerry.Errors"
                  value="NotReady,ContactSyncFailed"/>
    </method>
    <method name="IsHealthy">
      <arg name="healthy" type="b" direction="out"/>
    </method>
    <method name="OpenLegacyGtkMessage">
      <annotation name="org.freedesktop.DBus.Description"
                  value="Route a notification to a GTK window left open across an upgrade"/>
      <arg name="handle" type="s" direction="in"/>
      <arg name="application_owner" type="s" direction="in"/>
      <arg name="delivered" type="b" direction="out"/>
      <annotation name="io.weirdware.BlueFerry.Errors" value="InvalidArgs"/>
    </method>
  </interface>
  <interface name="io.weirdware.BlueFerry.Presence1">
    <annotation name="org.freedesktop.DBus.Description"
                value="Opt-in lock-only desktop lock when the iPhone goes away; state is in Messages1.GetStatus"/>
    <method name="SetProximityLock">
      <arg name="enabled" type="b" direction="in"/>
      <arg name="grace_seconds" type="u" direction="in"/>
      <arg name="status_json" type="s" direction="out"/>
      <annotation name="io.weirdware.BlueFerry.Errors"
                  value="InvalidArgs,NotReady"/>
    </method>
  </interface>
  <interface name="io.weirdware.BlueFerry.Media1">
    <annotation name="org.freedesktop.DBus.Description"
                value="Opt-in iPhone now-playing and media commands over Apple Media Service"/>
    <annotation name="io.weirdware.BlueFerry.Errors"
                value="AuthorizationRequired,RateLimited"/>
    <method name="GetNowPlaying">
      <annotation name="org.freedesktop.DBus.Description"
                  value="JSON snapshot; enabled is false unless the user opted in"/>
      <arg name="json" type="s" direction="out"/>
      <annotation name="io.weirdware.BlueFerry.Errors"
                  value="ResponseTooLarge"/>
    </method>
    <method name="SetMediaControl">
      <annotation name="org.freedesktop.DBus.Description"
                  value="Persist the opt-in and start or stop media control at once; returns the media_control_* status keys"/>
      <arg name="enabled" type="b" direction="in"/>
      <arg name="status_json" type="s" direction="out"/>
      <annotation name="io.weirdware.BlueFerry.Errors"
                  value="InvalidArgs,NotReady"/>
    </method>
    <method name="SendMediaCommand">
      <annotation name="org.freedesktop.DBus.Description"
                  value="play, pause, toggle, next, previous, volume-up, volume-down, repeat, shuffle, skip-forward, skip-backward, like, dislike, bookmark"/>
      <arg name="command" type="s" direction="in"/>
      <annotation name="io.weirdware.BlueFerry.Errors"
                  value="InvalidArgs,NotReady,MediaCommandFailed"/>
    </method>
  </interface>
  <interface name="io.weirdware.BlueFerry.Calls1">
    <annotation name="org.freedesktop.DBus.Description"
                value="Optional, default-off iPhone call control through oFono HFP; see README"/>
    <annotation name="io.weirdware.BlueFerry.Errors"
                value="AuthorizationRequired,RateLimited,CallsDisabled"/>
    <method name="SetCallsEnabled">
      <annotation name="org.freedesktop.DBus.Description"
                  value="Save the opt-in and apply it without a restart; returns the calls_* GetStatus keys as JSON"/>
      <arg name="enabled" type="b" direction="in"/>
      <arg name="status_json" type="s" direction="out"/>
      <annotation name="io.weirdware.BlueFerry.Errors"
                  value="InvalidArgs,NotReady"/>
    </method>
    <method name="ListCalls">
      <arg name="json" type="s" direction="out"/>
      <annotation name="io.weirdware.BlueFerry.Errors"
                  value="ResponseTooLarge"/>
    </method>
    <method name="Dial">
      <arg name="number" type="s" direction="in"/>
      <arg name="call_id" type="s" direction="out"/>
      <annotation name="io.weirdware.BlueFerry.Errors"
                  value="InvalidArgs,CallsUnavailable,CallFailed"/>
    </method>
    <method name="Answer">
      <arg name="call_id" type="s" direction="in"/>
      <annotation name="io.weirdware.BlueFerry.Errors"
                  value="InvalidArgs,NotFound,CallsUnavailable,CallFailed"/>
    </method>
    <method name="Hangup">
      <annotation name="org.freedesktop.DBus.Description"
                  value="Hang up an active or held call, or decline a ringing one"/>
      <arg name="call_id" type="s" direction="in"/>
      <annotation name="io.weirdware.BlueFerry.Errors"
                  value="InvalidArgs,NotFound,CallsUnavailable,CallFailed"/>
    </method>
    <method name="HangupAll">
      <annotation name="io.weirdware.BlueFerry.Errors"
                  value="CallsUnavailable,CallFailed"/>
    </method>
    <method name="SendTones">
      <arg name="call_id" type="s" direction="in"/>
      <arg name="tones" type="s" direction="in"/>
      <annotation name="io.weirdware.BlueFerry.Errors"
                  value="InvalidArgs,NotFound,CallsUnavailable,CallFailed"/>
    </method>
    <method name="SwapCalls">
      <annotation name="io.weirdware.BlueFerry.Errors"
                  value="CallsUnavailable,CallFailed"/>
    </method>
    <method name="HoldAndAnswer">
      <annotation name="io.weirdware.BlueFerry.Errors"
                  value="InvalidArgs,CallsUnavailable,CallFailed"/>
    </method>
  </interface>
  <interface name="io.weirdware.BlueFerry.Events1">
    <annotation name="org.freedesktop.DBus.Description"
                value="Content-free live invalidations; snapshots are fetched with Messages1"/>
    <signal name="HistoryChanged">
      <arg name="revision" type="a{sv}"/>
    </signal>
    <signal name="StatusChanged"/>
    <signal name="OpenMessageRequested">
      <arg name="handle" type="s"/>
    </signal>
    <signal name="NowPlayingChanged">
      <annotation name="org.freedesktop.DBus.Description"
                  value="Content-free; fetch details with Media1.GetNowPlaying"/>
    </signal>
    <signal name="CallsChanged">
      <annotation name="org.freedesktop.DBus.Description"
                  value="Call state changed; fetch details with Calls1.ListCalls"/>
    </signal>
  </interface>
</node>
